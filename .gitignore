# Build output. The binary is built from ./cmd/wssh, so it lands here only if
# someone runs `go build ./cmd/wssh` from the root.
/wssh
/bin/

# Host key generated on first run. Never commit it: it is the server identity,
# and a leaked key lets anyone impersonate the host.
/host_ed25519
/host_ed25519.pub

# Dependency checksums are not tracked; go regenerates them on demand.
/go.sum

# Optional client wrapper around websocat. Useful locally, but plain
# `websocat -b wss://host` covers the common case, so it stays untracked.
/wssh-proxy

# WASM build output: rebuild with client/build.sh
/webui/static/ssh.wasm
/webui/static/wasm_exec.js

# Keys written into the working directory by a command with no --out-dir.
# `wssh keygen id_ed25519` defaults to the current directory, and the selftest
# instructions ask for `--hostkey ./hk`, so both land here during ordinary use.
# A private key that reaches a commit is the one mistake here that cannot be
# walked back.
/id_ed25519
/id_ed25519.pub
/hostkey

# The RouterCafe ledger, written by running the server with no --ledger: the
# default path is the bare name `routercafe.json`, so it lands in whatever
# directory the binary was started from.
#
# Every balance in the system, plus the SHA-256 of every API key. The keys
# themselves are hashed rather than stored, so this is not a list of live
# credentials - but it is the whole of what anybody's money is, and it is
# unbacked: nothing in the file would notice it being edited. Point --ledger
# or $ROUTERCAFE_LEDGER somewhere outside a checkout; this line is the net for
# the case where nobody did.
/routercafe.json

# Ledger of a local Solana validator: genesis, a rocksdb tree, and faucet
# keypairs. Over a gigabyte, and never anything a commit should carry.
/test-ledger/

# Where a release build lands: three binaries per platform, their archives,
# checksums, and goreleaser's own metadata. A few hundred megabytes of output
# that is rebuilt by tagging, and never something a commit should carry.
/dist
